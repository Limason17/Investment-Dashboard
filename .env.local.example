# Optional: Overnight-Kurse (20:00–04:00 New York) über Alpaca.
# Gratis-Konto auf https://alpaca.markets anlegen (kein Geld nötig), im Dashboard unter
# «API Keys» einen Schlüssel erzeugen, diese Datei in «.env.local» umbenennen und die zwei Werte eintragen.
# .env.local bleibt auf diesem Rechner; der Schlüssel geht nie an den Browser.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
